PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/matgreen?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/matgreen

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=matgreen_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://matgreen.vercel.app

# AI Service Link
AI_SERVICE_URL=http://localhost:8000

# Image Storage (local / cloudinary)
# Mặc định: local (tự động nén WebP bằng Sharp và lưu trên VPS)
IMAGE_STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
UPLOAD_MAX_IMAGE_SIZE_BYTES=10485760

# Cloudinary Storage (Dự phòng nếu muốn chuyển sang Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=matgreen

# Email SMTP (Gmail / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="MatGreenNV" <your_email@gmail.com>
