PORT=8000
# Kết nối tới local CLIProxyAPI (cli-proxy-public) thông qua Docker network cliproxyapi_default
AI_PROXY_BASE_URL=http://cli-proxy-public:8317/v1
AI_PROXY_API_KEY=replace_with_cli_proxy_public_api_key
AI_CHAT_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_MODEL=gemini-3-flash
AI_CHAT_TIMEOUT_SECONDS=45

# Vision AI (nhận diện ảnh vật liệu / hiện trường công trình)
# Mặc định dùng chung AI_PROXY_BASE_URL và AI_PROXY_API_KEY nếu để trống
AI_VISION_PROXY_BASE_URL=http://cli-proxy-public:8317/v1
AI_VISION_PROXY_API_KEY=
AI_VISION_MODEL=gemini-3-flash
AI_VISION_TIMEOUT_SECONDS=90

# Kết nối nội bộ & Bảo mật dùng chung với matgreen_backend
BACKEND_BASE_URL=http://backend:5000
JWT_SECRET=matgreen_dev_secret_key_1234567890
REDIS_URL=redis://redis:6379
RATE_LIMIT_KEY_PREFIX=matgreen:ai

# Hạn mức sử dụng AI
MAX_REQUESTS_PER_MINUTE=12
MAX_DAILY_REQUESTS_USER=50
MAX_REQUESTS_PER_MINUTE_GUEST=4
MAX_DAILY_REQUESTS_GUEST=5
MAX_GLOBAL_REQUESTS_PER_MINUTE=120
AI_UNLIMITED_ROLES=admin,moderator,superadmin

# Giới hạn Tool Calling & Hội thoại
MAX_TOOL_ROUNDS=6
MAX_TOTAL_TOOL_CALLS=15
MAX_HISTORY_MESSAGES=20
CHAT_MAX_COMPLETION_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=20

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://matgreen.vercel.app
